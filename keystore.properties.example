# Copy this file to keystore.properties. The real file remains ignored by Git.
# Keep the upload keystore outside the repository and use an absolute path.
# Forward slashes avoid Java Properties escaping surprises on Windows.
storeFile=C:/secure/password-memory-upload.jks
storePassword=replace-with-the-upload-keystore-password
keyAlias=password-memory-upload
keyPassword=replace-with-the-upload-key-password
