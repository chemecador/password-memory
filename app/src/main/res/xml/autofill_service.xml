<?xml version="1.0" encoding="utf-8"?>
<!--
  Browsers that do not implement the autofill framework themselves are driven in compatibility
  mode, where the system reads their accessibility tree instead. Everything else works natively.
-->
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.chemecador.passwordmemory.MainActivity">
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="com.android.chrome" />
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="com.chrome.beta" />
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="com.android.browser" />
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="org.mozilla.firefox" />
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="com.opera.browser" />
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="com.brave.browser" />
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="com.microsoft.emmx" />
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="com.sec.android.app.sbrowser" />
    <compatibility-package
        android:maxLongVersionCode="1000000000"
        android:name="com.duckduckgo.mobile.android" />
</autofill-service>
